---
import ImageReveal from '@components/react/ImageReveal';
import { Image } from 'astro:assets';
import projeEkibiImg from '@assets/photo-1552664730-d307ca884978-2.webp';
import fleetImg from '@assets/esli6-2.webp';
import manufacturingImg from '@assets/esli6-2.webp';
import commandCenterImg from '@assets/photo-1551288049-bebda4e38f71-2.webp';
import distributionImg from '@assets/photo-1601584115197-04ecc0da31d7.jpg';
---

<section class="section-bg-dark py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="pill-gold small">
        Operasyonel Gücümüz
      </div>
      <h2 class="heading-section">
        Neden <span class="text-gold">Tanas Fuarcılık?</span>
      </h2>
      <p class="text-body text-body-secondary max-w-3xl mx-auto">
        Projelerinizi yalnızca tasarlamıyor; üretimden saha uygulamasına kadar tüm operasyonel süreci kendi ekibimiz ve altyapımız ile yönetiyoruz.
        Zaman, kalite ve saha koordinasyonu bizim kontrolümüzde.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Large featured image -->
      <div class="md:row-span-2">
        <ImageReveal client:load delay={0}>
          <div class="relative h-full group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={projeEkibiImg}
              alt="Automated warehouse with modern robotics"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={1200}
              height={900}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
              <h3 class="heading-subsection mb-2">Proje Ekibi</h3>
              <p class="text-gray-200">Tasarım, üretim ve saha kurulum süreçleri tek ekip tarafından yürütülür.</p>
            </div>
          </div>
        </ImageReveal>
      </div>

      <ImageReveal client:load delay={0.1}>
        <div class="relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
          <Image 
            src={fleetImg}
            alt="Fleet of modern delivery trucks"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            width={800}
            height={600}
          />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="heading-subsection mb-1">Üretim Gücü</h3>
            <p class="text-gray-200">Demir konstrüksiyon, ahşap imalat ve reklam uygulamaları kendi bünyemizde üretilir.</p>
          </div>
        </div>
      </ImageReveal>

      <ImageReveal client:load delay={0.2}>
        <div class="relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
          <Image 
            src={manufacturingImg}
            alt="Manufacturing floor with precision equipment"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            width={800}
            height={600}
          />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="heading-subsection mb-1">Zamanında Teslim</h3>
            <p class="text-gray-200">Planlanan tarihte eksiksiz saha uygulaması.</p>
          </div>
        </div>
      </ImageReveal>

      <div class="lg:row-start-3">        
        <ImageReveal client:load delay={0.3}>
          <div class="lg:col-span-2 relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={commandCenterImg}
              alt="Control center with real-time monitoring"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={1200}
              height={600}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="heading-subsection mb-1">Operasyonel Destek</h3>
              <p class="text-gray-200">Forklift, ekipman ve saha teknik desteği dahil kapsamlı hizmet.</p>
            </div>
          </div>
        </ImageReveal>
      </div>
      <div class="lg:row-start-2 lg:col-start-2 lg:row-span-2 lg:col-span-2">        
        <ImageReveal client:load delay={0.4}>
          <div class="relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={distributionImg}
              alt="Distribution center with sorting systems"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={800}
              height={600}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="heading-subsection mb-1">Avrupaya Hizmet</h3>
              <p class="text-gray-200">Tüm avrupa ülkelerinde hizmet veriyoruz.</p>
            </div>
          </div>
        </ImageReveal>
      </div>
    </div>
  </div>
</section>

