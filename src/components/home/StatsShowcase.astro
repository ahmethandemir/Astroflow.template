---
import { Image } from 'astro:assets';
import AnimatedStats from '../react/AnimatedStats';
import logisticsNetworkImg from '@assets/photo-1578575437130-527eed3abbec.jpg';
import sapLogo from '@assets/SAP.jpg';
import mcKinseyLogo from '@assets/mckinsey.png';
import deloitteLogo from '@assets/deloitte.jpg';
import socarLogo from '@assets/socar.webp';
---

<section class="section-bg-dark relative py-24 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <Image 
      src={logisticsNetworkImg}
      alt="Global logistics network"
      class="w-full h-full object-cover"
      width={2070}
      height={1380}
    />
    <div class="absolute inset-0 bg-slate-900/90"></div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="pill-gold mb-4">
        Deneyim & Güven
      </div>
      <h2 class="heading-section">
        Sektör Liderderi <span class="text-gold">Tanas'ı Tercih Ediyor!</span>
      </h2>
      <p class="text-body text-body-secondary max-w-4xl mx-auto">
        16 yılı aşkın süredir, ulusal ve uluslararası birçok organizasyonda projelerimizi başarıyla tamamladık.<br><br> Ulusal ve uluslararası organizasyonlarda aktif olarak görev aldık.
      </p>
    </div>

    <AnimatedStats client:load />

    <!-- Trusted By Section -->
    <div class="mt-20">
      <p class="text-center text-slate-400 text-label mb-8">
        Trusted by Fortune 500 Companies
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {/* Client logos placeholder */}

        <div class="flex items-center justify-center group">
            <Image 
              src={sapLogo}
              alt="Industry solutions and use cases"
              class="object-cover"
              width={200}
              height={150}
            />
        </div>
        <div class="flex items-center justify-center group">
            <Image 
              src={mcKinseyLogo}
              alt="Industry solutions and use cases"
              class="object-cover"
              width={200}
              height={150}
            />
        </div>
        <div class="flex items-center justify-center group">
            <Image 
              src={deloitteLogo}
              alt="Industry solutions and use cases"
              class="object-cover"
              width={200}
              height={150}
            />
        </div>
        <div class="flex items-center justify-center group">
            <Image 
              src={socarLogo}
              alt="Industry solutions and use cases"
              class="object-cover"
              width={200}
              height={150}
            />
        </div>
      </div>
      </div>
    </div>
  </div>
</section>

